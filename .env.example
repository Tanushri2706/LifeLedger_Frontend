# LifeLedger Frontend Environment Variables
# Public configuration only — never commit secrets or private API keys to frontend environments.

# Backend REST API Base URL
# Development: http://localhost:5000/api/v1
# Production: https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Frontend Canonical Origin (used for metadataBase and OpenGraph resolution)
# Development: http://localhost:3000
# Production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
